#!/bin/sh
# tide-step — opakowanie kroku w pudełku karty (PT-169, #6; runner zapisuje je w <krok>/in/bin).
#
# Uruchamiane przez BoxRunner jako usługa użytkownika `agent` (systemd-run --user … -- tide-step <argv agenta>)
# z jedną zmienną TIDE_STEP=<katalog kroku>. Kolejno:
#  1. czyści środowisko (env -i), odczytuje jawne ustawienia stosów obrazu i <krok>/in/env,
#  2. sprawdza <krok>/in/env: zwykły plik (nie dowiązanie), tryb 0600, właściciel = bieżący użytkownik — inaczej
#     odmawia (kod 125), bo tokeny punktu lokalnego nie mogą leżeć w pliku czytelnym dla innych,
#  3. eksportuje wiersze KLUCZ=wartość bez `eval` (wartości nigdy nie trafiają do argv — `ps` hosta widzi argv
#     procesów pudełka), pomija puste wiersze i komentarze, odmawia przy niepoprawnej nazwie,
#  4. przechodzi do TIDE_CWD z in/env (katalog roboczy kroku), zakłada CLAUDE_CODE_TMPDIR, gdy jest,
#  5. uruchamia polecenie z <krok>/in/prompt.txt na stdin i wyjściem dopisywanym do <krok>/out/step.log,
#  6. zapisuje kod wyjścia atomowo w <krok>/in/exit-code (jak EXIT_WRAPPER hosta) i kończy się nim.
# SIGTERM (systemctl --user kill) dostaje cała jednostka; opakowanie go przeczekuje, żeby zapisać kod.
#
# Tryb polecenia (K-109 PT-479, ADR-1): `tide-step --command <plik exit-code> <plik wyniku> -- <argv>` — jedno
# polecenie nie-agentowe jako proces główny przejściowej usługi `tide-cmd-<attempt>` (HostRunner.run_command).
# Bez TIDE_STEP i bez czyszczenia środowiska (etap 1: `isolation: none`, środowisko podaje jednostka). Polecenie
# dostaje stdin z /dev/null i dopisuje wyjście do pliku wyniku. Kod wyjścia trafia atomowo (plik `.tmp` i `mv`)
# do pliku exit-code; SIGTERM (zatrzymanie jednostki, przekroczony RuntimeMaxSec) zapisuje od razu `zatrzymane`,
# przekazuje sygnał poleceniu i czeka na jego koniec — wynik nie zależy od klienta `systemd-run --wait`. Wczesny
# zapis chroni wynik przed SIGKILL po TimeoutStopSec; `zatrzymane` jest wynikiem końcowym dopiero po końcu jednostki
# (HostRunner.command_result).
set -u
umask 077

if [ "${1:-}" = --command ]; then
    # Pułapka przed walidacją argumentów (K-109 PT-479, test_c): SIGTERM z RuntimeMaxSec tuż po starcie jednostki
    # nie kończy powłoki domyślnie bez pliku. Do ustalenia `status` sygnał tylko ustawia `stopped`; zapis
    # `zatrzymane` następuje zaraz po odczycie argumentów, bez startu polecenia.
    status=
    stopped=
    recorded=
    child=
    # Zapis odporny na SIGTERM jednostki: przy KillMode=control-group systemd dosyła TERM także procesom
    # rozwidlonym w trakcie zatrzymania (np. `mv` z pułapki), co zostawiało `exit-code.tmp` bez pliku. Na czas
    # zapisu powłoka ignoruje TERM, a `mv` dziedziczy ignorowanie (zachowane przez exec); potem pułapka wraca.
    record() {
        trap '' TERM
        printf '%s\n' "$1" > "$status.tmp" && mv -f -- "$status.tmp" "$status"
        rc=$?
        trap on_term TERM
        return "$rc"
    }
    # `wait` przerwany sygnałem z pułapką wraca od razu (POSIX), więc zapis `zatrzymane` nie czeka na polecenie.
    # Kod zapisany przed sygnałem zostaje (polecenie skończyło się samo).
    on_term() {
        if [ -z "$stopped" ] && [ -z "$recorded" ]; then
            stopped=1
            [ -z "$status" ] || record zatrzymane
        fi
        [ -z "$child" ] || kill -TERM "$child" 2>/dev/null
    }
    trap on_term TERM
    if [ "$#" -lt 5 ] || [ "$4" != -- ]; then
        echo "tide-step: użycie: tide-step --command <exit-code> <wynik> -- <polecenie…>" >&2
        exit 125
    fi
    output=$3
    rm -f -- "$2.tmp"
    status=$2
    shift 4
    if [ -n "$stopped" ]; then
        # SIGTERM przed odczytem argumentów: zapis teraz, polecenie nie startuje.
        record zatrzymane
        exit 143
    fi
    "$@" < /dev/null >> "$output" 2>&1 &
    child=$!
    while :; do
        wait "$child"
        code=$?
        kill -0 "$child" 2>/dev/null || break
    done
    # Od razu po końcu polecenia: późny SIGTERM nie zamienia już normalnego końca w `zatrzymane`.
    recorded=1
    if [ -n "$stopped" ]; then
        exit 143
    fi
    record "$code"
    exit "$code"
fi

if [ "${TIDE_STEP_CLEAN:-}" != 1 ]; then
    step=${TIDE_STEP:-}
    [ -n "$step" ] || { echo "tide-step: brak TIDE_STEP" >&2; exit 125; }
    exec /usr/bin/env -i TIDE_STEP_CLEAN=1 TIDE_STEP="$step" /bin/sh "$0" "$@"
fi
step=$TIDE_STEP
unset TIDE_STEP_CLEAN
# Po `env -i` jawnie (ta sama wartość co BOX_PATH w runner.py) — domyślna ścieżka powłoki nie jest pewna;
# in/env może ją potem nadpisać.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
# Szablony stosów zapisują te wartości w obrazie. Nie dziedziczymy środowiska hosta ani nie
# wykonujemy /etc/environment jako powłoki. Ustawienia kroku poniżej mają pierwszeństwo.
stackfile=/etc/environment
if [ -f "$stackfile" ] && [ ! -L "$stackfile" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        key=${line%%=*}
        case $key in
            CHROME_BIN | PLAYWRIGHT_BROWSERS_PATH | NODE_USE_ENV_PROXY | DOTNET_ROOT | \
            DOTNET_CLI_TELEMETRY_OPTOUT | DOTNET_NOLOGO | DOTNET_SKIP_FIRST_TIME_EXPERIENCE | QT_QPA_PLATFORM) ;;
            *) continue ;;
        esac
        [ "$line" != "$key" ] || continue
        value=${line#*=}
        case $value in \"*\") value=${value#\"}; value=${value%\"} ;; esac
        case $value in *[!A-Za-z0-9._/:,-]*) continue ;; esac
        export "$key=$value"
    done < "$stackfile"
fi
unset stackfile line key value
envfile="$step/in/env"

if [ ! -f "$envfile" ] || [ -L "$envfile" ]; then
    echo "tide-step: brak pliku $envfile" >&2
    exit 125
fi
mode=$(stat -c %a -- "$envfile") || exit 125
owner=$(stat -c %u -- "$envfile") || exit 125
if [ "$mode" != 600 ]; then
    echo "tide-step: $envfile ma tryb $mode zamiast 600 — odmowa" >&2
    exit 125
fi
if [ "$owner" != "$(id -u)" ]; then
    echo "tide-step: właścicielem $envfile nie jest bieżący użytkownik — odmowa" >&2
    exit 125
fi

while IFS= read -r line || [ -n "$line" ]; do
    case $line in
        '' | '#'*) continue ;;
    esac
    key=${line%%=*}
    case $key in
        '' | [0-9]* | *[!A-Za-z0-9_]*)
            echo "tide-step: niepoprawny wiersz w in/env" >&2
            exit 125 ;;
    esac
    if [ "$key" = "$line" ]; then
        echo "tide-step: wiersz bez '=' w in/env" >&2
        exit 125
    fi
    export "$line"
done < "$envfile"
unset line key mode owner

if [ -n "${TIDE_CWD:-}" ]; then
    cd -- "$TIDE_CWD" || { echo "tide-step: brak katalogu roboczego $TIDE_CWD" >&2; exit 125; }
fi
if [ -n "${CLAUDE_CODE_TMPDIR:-}" ]; then
    mkdir -p -- "$CLAUDE_CODE_TMPDIR" || exit 125
fi
[ "$#" -gt 0 ] || { echo "tide-step: brak polecenia" >&2; exit 125; }

status="$step/in/exit-code"
rm -f -- "$status" "$status.tmp"
mkdir -p -- "$step/out"
prompt="$step/in/prompt.txt"
[ -f "$prompt" ] || prompt=/dev/null
trap : TERM
"$@" < "$prompt" >> "$step/out/step.log" 2>&1
code=$?
printf '%s\n' "$code" > "$status.tmp" && mv -f -- "$status.tmp" "$status"
exit "$code"
