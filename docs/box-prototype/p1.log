--- nft list table inet tide-box (przed regułami chwilowymi)
table inet tide-box {
	chain input {
		type filter hook input priority filter + 10; policy accept;
		iifname "incusbr0" ip daddr 10.173.184.1 tcp dport 18080 accept comment "proxy Tide"
		iifname "incusbr0" udp sport 68 udp dport 67 accept comment "DHCP"
		iifname "incusbr0" meta l4proto { tcp, udp } th dport 53 drop comment "DNS tylko przez proxy"
		iifname "incusbr0" drop
	}

	chain forward {
		type filter hook forward priority filter + 10; policy accept;
		iifname "incusbr0" drop
		oifname "incusbr0" drop
	}
}
--- koniec: nft list table inet tide-box (przed regułami chwilowymi)
