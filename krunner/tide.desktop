[Desktop Entry]
Type=Service
Name=Tide: agenci i projekty
Comment=Wznawia sesje Claude Code i Codexa z ostatnich 30 dni, otwiera projekty i worktrees
Icon=utilities-terminal
X-KDE-PluginInfo-Name=tide
X-KDE-PluginInfo-Author=Tide
X-KDE-PluginInfo-Version=1.0
X-KDE-PluginInfo-License=GPL
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.tide.Daemon.KRunner
X-Plasma-DBusRunner-Path=/KRunner
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=3
X-Plasma-Runner-Syntaxes=:q:,ai :q:
X-Plasma-Runner-Syntax-Descriptions=Sesje agentów z ostatnich 30 dni oraz projekty i worktrees pasujące do :q:,Tylko sesje agentów pasujące do :q:
